# Copiar a .env.local para desarrollo. Ningún valor real va en el repo.

# URL pública del sitio, con protocolo y sin barra final. De acá salen
# metadataBase, canonical, hreflang, sitemap, robots y el JSON-LD.
# Sin ella: en Vercel se usa el dominio de producción del proyecto, y en
# local http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# VERCEL_ENV y VERCEL_PROJECT_PRODUCTION_URL las pone Vercel sola; no se
# configuran. Con VERCEL_ENV distinto de "production" el sitio no se indexa.
